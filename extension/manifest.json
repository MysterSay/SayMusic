{
  "manifest_version": 3,
  "name": "Say Music — YouTube Music & Spotify",
  "version": "1.5.35",
  "description": "Додавання пісень і цілих плейлистів YouTube та Spotify до Say Music.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "storage",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://youtube.com/*",
    "https://www.youtube.com/*",
    "https://music.youtube.com/*",
    "https://spotify.com/*",
    "https://open.spotify.com/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Say Music"
  },
  "icons": {
    "16": "icon16.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://music.youtube.com/*",
        "https://www.youtube.com/*"
      ],
      "js": [
        "membership.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://open.spotify.com/*"
      ],
      "js": [
        "membership.js",
        "spotify.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "optional_permissions": [
    "cookies"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; connect-src http://127.0.0.1:17843"
  }
}
