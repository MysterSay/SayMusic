{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "q7m4v9k2r8",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-24",
  "workers_dev": true,
  "observability": {
    "enabled": false
  },
  "migrations": [
    {
      "tag": "auth-v1",
      "new_sqlite_classes": [
        "AuthFlow"
      ]
    },
    {
      "tag": "auth-removed-v2",
      "deleted_classes": [
        "AuthFlow"
      ]
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
